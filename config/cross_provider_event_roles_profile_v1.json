{
  "version": "cross-provider-event-roles-profile-v1",
  "milestone": "M236",
  "description": "Classify BZ/Dow Jones/Marketaux events by event role, provider confirmation, and conflict. Produces scorer evidence packet v3 artifact. Alpha Vantage rows are excluded from active training inputs.",
  "paths": {
