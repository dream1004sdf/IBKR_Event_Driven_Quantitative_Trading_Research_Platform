{
  "profile_version": "m231-threshold-candidate-evaluator-profile-v3",
  "milestone": "M231",
  "description": "Shadow-only evaluator for M225 OpenAI adjustment-note threshold candidates. It ranks candidates and applies the M231 Promotion Gate with singleton-loop protection, recycle-state/history tracking, near-return alerts, dormant/retired lifecycle, and option root-cause policy without mutating the live scorer or promoting thresholds.",
  "paths": {
