    "promotion_gate_recent_trial_count": 3,
    "promotion_gate_min_recent_acceptance_score": 75.0,
    "promotion_gate_max_abs_error_worsening_pct": 0.25,
    "promotion_gate_max_regime_family_share": 0.85,
    "promotion_gate_watchlist_enabled": true,
    "promotion_gate_watchlist_stale_ticks": 10,
