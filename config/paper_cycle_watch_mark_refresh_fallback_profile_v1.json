{
  "profile_version": "paper-cycle-watch-profile-v1",
  "milestone": "M139",
  "description": "M139 calendar-gated watch profile with read-only mark refresh, fallback reuse policy, and M137 data-quality preflight.",
  "paths": {
    "auto_gate_json": "../exports/m113_m112_auto_execution_gate.json",
    "portfolio_risk_state_json": "../exports/m128_next_portfolio_risk_state.json",
    "fill_marks_json": "../exports/m139_mark_refresh_fallback_stock_mark_snapshot.json",
    "loop_marks_jsons": [
      "../exports/m139_mark_refresh_fallback_stock_mark_snapshot.json"
    ],
    "exit_router_json": "../exports/m121_m120_paper_exit_router.json",
    "checkpoint_path": "../exports/m139_mark_refresh_fallback_watch_checkpoint.json",
    "watch_state_json": "../exports/m139_mark_refresh_fallback_watch_state.json"
  },
  "session_gate": {
    "enabled": true,
    "calendar_json": "paper_market_calendar_us_v1.json",
    "allowed_sessions": [
      "regular"
    ],
    "weekdays": [
      0,
      1,
      2,
      3,
      4
    ]
  },
  "mark_refresh": {
    "enabled": true,
    "ignore": false,
    "required": true,
    "mode": "ibkr",
    "source_json": "../exports/m117_ibkr_stock_mark_snapshot.json",
    "symbols": [],
    "quote_seconds": 8.0,
    "market_data_type": 1,
    "client_id_offset": 9400,
    "write_fill_marks_json": true,
    "write_loop_marks_jsons": true,
    "fallback": {
      "enabled": true,
      "reuse_on_failure": true,
      "reuse_on_partial": true,
      "max_source_age_seconds": 28800.0,
      "min_marked_ratio": 1.0,
      "max_missing_symbols": 0,
      "allow_delayed": false
    }
  },
  "preflight_gate": {
    "enabled": true,
    "ignore": false,
    "max_snapshot_age_seconds": 28800.0,
    "max_tick_age_seconds": 28800.0,
    "allow_delayed": false,
    "require_all_marked": true,
    "min_marked_ratio": 1.0
  },
  "watch": {
    "skip_unchanged_inputs": true,
    "force_run": false,
    "cycles_per_run": 1,
    "dedupe_across_cycles": true,
    "carry_dedupe_state_across_runs": true,
    "max_intents": 10,
    "sample_limit": 20
  },
  "execution": {
    "fill_price_source": "require_marks",
    "fill_model": "ibkr_mark_reference_fill_v1",
    "max_orders": 10,
    "slippage_bps": 0.0,
    "commission_per_order": 0.0
  },
  "risk_limits": {
    "monitor_size_multiplier": 0.5,
    "take_profit_pct": 0.03,
    "stop_loss_pct": 0.02,
    "max_gross_exposure": 100000.0,
    "max_symbol_exposure": 25000.0,
    "max_short_exposure": 25000.0,
    "max_unrealized_loss": 1000.0,
    "max_total_loss": 1000.0,
    "max_open_symbols": 25,
    "warning_ratio": 0.8
  },
  "outputs": {
    "output": "../exports/m139_mark_refresh_fallback_default_tick.md",
    "json_output_path": "../exports/m139_mark_refresh_fallback_default_tick.json"
  },
  "safety": {
    "paper_only": true,
    "mark_refresh_read_only_market_data": true,
    "fallback_reuses_existing_paper_snapshots_only": true,
    "live_order_routing_enabled": false,
    "ibkr_order_submitted": false,
    "transmit_enabled": false
  }
}
