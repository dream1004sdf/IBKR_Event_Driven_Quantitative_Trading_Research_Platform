{
  "policy_version": "execution-safety-cache-supervisor-profile-v1",
  "created_at": "2026-07-01",
  "milestone": "M211",
  "purpose": "Keep slow pre-order safety checks warm outside the emergency execution hot path: broker margin what-if, short availability, and option quote/liquidity evidence.",
  "safety_cache_supervisor": {
    "enabled": false,
    "default_max_age_seconds": 300.0,
    "default_warning_age_seconds": 60.0,
    "stale_cache_action": "block_dependent_order_paths_until_refreshed",
    "refresh_execution_default": false,
    "allowed_refresh_commands": [],
    "caches": {
      "broker_margin_whatif_cache": {
        "role": "Broker-side margin/commission what-if evidence for margin-sensitive stock risk-reduction or entry orders.",
        "json_path": "../exports/m211_ibkr_defensive_order_whatif_cache.json",
        "fallback_json_path": "../exports/m190_defensive_broker_gate_v4/m189_ibkr_defensive_order_whatif_attempt_01.json",
        "required": false,
        "max_age_seconds": 300.0,
        "warning_age_seconds": 60.0,
        "block_order_paths_when_stale": [
          "margin_sensitive_entries",
          "defensive_stock_risk_reduction_without_fresh_margin_preview"
        ],
        "allow_execute_refresh": false,
        "refresh_command": [
          "{python}",
          "main.py",
          "ibkr-order-whatif-preview",
          "--preview-json",
          "exports/m188_operating_defensive_order_preview.json",
          "--max-orders",
          "5",
          "--include-human-review",
          "--allow-fractional",
          "--timeout-seconds",
          "20",
          "--output",
          "exports/m211_ibkr_defensive_order_whatif_cache.md",
          "--json-output-path",
          "exports/m211_ibkr_defensive_order_whatif_cache.json"
        ]
      },
      "short_availability_cache": {
        "role": "IBKR short-availability/locate evidence for new short stock entries.",
        "json_path": "../exports/m211_ibkr_short_availability_cache.json",
        "fallback_json_path": "../exports/m113_ibkr_short_availability.json",
        "required": false,
        "max_age_seconds": 300.0,
        "warning_age_seconds": 60.0,
        "block_order_paths_when_stale": [
          "new_short_stock_entries"
        ],
        "allow_execute_refresh": false,
        "refresh_command": [
          "{python}",
          "main.py",
          "ibkr-short-availability",
          "--symbols",
          "AMD,AMZN,INTC,ORCL,QCOM,SNOW,TSLA",
          "--timeout-seconds",
          "15",
          "--output",
          "exports/m211_ibkr_short_availability_cache.md",
          "--json-output-path",
          "exports/m211_ibkr_short_availability_cache.json"
        ]
      },
      "option_quote_liquidity_cache": {
        "role": "Session-aware defensive option quote/liquidity evidence for option entries and protective structures.",
        "json_path": "../exports/m211_session_aware_option_quote_gate.json",
        "fallback_json_path": "../exports/m191_session_aware_option_quote_gate.json",
        "required": false,
        "max_age_seconds": 300.0,
        "warning_age_seconds": 60.0,
        "block_order_paths_when_stale": [
          "new_option_entries",
          "protective_option_ticketing_without_fresh_quotes"
        ],
        "regular_session_dependent": true,
        "allow_execute_refresh": false,
        "refresh_command": [
          "{python}",
          "main.py",
          "operating-defensive-gate-retry",
          "--existing-whatif-json",
          "exports/m190_defensive_broker_gate_v4/m189_ibkr_defensive_order_whatif_attempt_01.json",
          "--existing-option-quote-json",
          "exports/m188_ibkr_defensive_option_quote_snapshot.json",
          "--run-option-quotes",
          "--regular-session-only-option-quotes",
          "--option-attempts",
          "2",
          "--option-market-data-types",
          "1,3,4",
          "--option-quote-seconds",
          "10",
          "--output-dir",
          "exports/m211_defensive_gate_retry_cache",
          "--output",
          "exports/m211_session_aware_option_quote_gate.md",
          "--json-output-path",
          "exports/m211_session_aware_option_quote_gate.json"
        ]
      }
    }
  },
  "output": {
    "report_json": "../exports/m211_execution_safety_cache_supervisor.json",
    "report_markdown": "../exports/m211_execution_safety_cache_supervisor.md",
    "tick_log_jsonl": "../exports/m211_execution_safety_cache_supervisor_ticks.jsonl"
  },
  "safety_requirements": {
    "ibkr_order_submitted": false,
    "live_order_transmitted": false,
    "live_order_routing_enabled": false,
    "portfolio_mutated": false,
    "scorer_rows_mutated": false,
    "broker_whatif_must_be_whatif_only": true
  }
}
