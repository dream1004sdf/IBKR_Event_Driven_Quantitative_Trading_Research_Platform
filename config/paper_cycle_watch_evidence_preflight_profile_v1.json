  "execution": {
    "fill_price_source": "require_marks",
    "fill_model": "ibkr_mark_reference_fill_v1",
    "max_orders": 10,
    "slippage_bps": 0.0,
    "commission_per_order": 0.0
  },
  "risk_limits": {
    "monitor_size_multiplier": 0.5,
    "take_profit_pct": 0.03,
    "stop_loss_pct": 0.02,
    "max_gross_exposure": 100000.0,
    "max_symbol_exposure": 25000.0,
    "max_short_exposure": 25000.0,
    "max_unrealized_loss": 1000.0,
    "max_total_loss": 1000.0,
    "max_open_symbols": 25,
    "warning_ratio": 0.8
  },
  "outputs": {
    "output": "../exports/m175_market_data_risk_watch_tick.md",
    "json_output_path": "../exports/m175_market_data_risk_watch_tick.json"
  },
  "safety": {
    "paper_only": true,
    "live_order_routing_enabled": false,
    "ibkr_order_submitted": false,
    "transmit_enabled": false
  }
}
